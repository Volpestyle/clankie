# Allowlist the build inputs, including uncommitted source changes. Never send
# a developer's home, credentials, node_modules, state or checkout artifacts.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!LICENSE
!README.md
!THIRD_PARTY_NOTICES.md
!install.sh
!patches/**
!vendor/**
!apps/
!apps/*/
!apps/*/package.json
!apps/*/src/**
!apps/tui/bin/**
!apps/vox/LICENSE
!apps/vox/PROVENANCE.md
!apps/vox/THIRD_PARTY_NOTICES.md
!packages/
!packages/*/
!packages/*/package.json
!packages/*/src/**
# Workspace integrations are bundled (Minecraft, Pokemon, OpenCode, plugins).
!integrations/**
!.agents/skills/**
# Runtime guides the release copies; ADRs and test evidence stay out.
!docs/*.md
!scripts/build-release.mjs
!scripts/build-herdr.mjs
!scripts/build-fleet-proof.mjs
!scripts/release/**
**/node_modules
**/.env*
**/.DS_Store
**/.git
**/dist
**/target
**/.turbo
!infra/hosted/README.md
