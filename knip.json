{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "docs/testing/2026-08-18-pokeagents-trial-run/flows/collect-run-evidence.mjs",
    "docs/testing/2026-09-26-hosted-connections/flows/serve.mts",
    "docs/testing/2026-09-26-work-items/flows/serve.mts",
    "vendor/opinionated-skills/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/evals/run.mjs",
        "scripts/evals/report.mjs",
        "docs/testing/2026-09-27-remote-fleet/connect/enroll-clankie.mjs",
        "docs/testing/2026-09-29-browser-bursts/flows/smoke.mjs",
        "docs/testing/2026-09-04-astra-terra-comparison/flows/assert-suite.mjs",
        "docs/testing/2026-09-04-linux-service-spike/flows/pairing-and-seat-dm.ts",
        "docs/testing/2026-09-04-linux-service-spike/flows/synthetic-provider.mjs",
        "docs/testing/2026-09-04-linux-service-spike/flows/guard-proof.mjs",
        "docs/testing/2026-09-04-case-b-execution-metrics/flows/check-arm.mjs",
        "docs/testing/2026-09-05-pokeagent-evidence-sweep/flows/sweep-play-archive.mjs",
        "docs/testing/2026-09-20-delivered-files-live/flows/build-presentation.mjs",
        "docs/testing/2026-09-20-delivered-files-live/flows/build-workbook.mjs",
        "docs/testing/2026-09-20-delivered-files-live/flows/run-isolated-proof.mjs",
        "integrations/claude-plugin/worker/bin/swarm-mcp.mjs"
      ],
      "paths": {
        "/clankie/*": ["./*"]
      }
    },
    "apps/clankie": {
      "entry": ["test/fixtures/browser-mcp-server.mjs"]
    },
    "apps/discord-user-session": {
      "entry": ["src/presence-runtime-module.ts"]
    },
    "packages/play": {
      "ignoreExportsUsedInFile": true
    },
    "packages/swarm": {
      "ignoreDependencies": ["@volpestyle/lead-skills"]
    }
  },
  "ignoreIssues": {
    "docs/testing/2026-09-20-delivered-files-live/flows/build-presentation.mjs": ["unlisted"],
    "docs/testing/2026-09-20-delivered-files-live/flows/build-workbook.mjs": ["unlisted"]
  }
}
