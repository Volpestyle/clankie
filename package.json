{
  "name": "clankie",
  "version": "0.2.0",
  "private": true,
  "description": "Clankie: a persistent agent who codes, leads herdr fleets, plays games, and hangs out in Discord.",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.config.ts",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "docs:check": "node scripts/check-doc-links.mjs",
    "check": "pnpm fmt:check && pnpm lint && pnpm docs:check && pnpm typecheck && pnpm test",
    "doctor": "node scripts/doctor.mjs",
    "cli:install": "node scripts/install-cli.mjs",
    "clean": "turbo run clean && rm -rf .turbo .data",
    "gba:free-play": "pnpm --filter @clankie/gba-emulator free-play",
    "gba:free-play-live": "pnpm --filter @clankie/clankie free-play-live",
    "gba:mcp-probe": "pnpm --filter @clankie/gba-mcp probe",
    "discord:readiness": "pnpm --filter @clankie/discord-bridge readiness",
    "discord:voice-readiness": "pnpm --filter @clankie/discord-bridge voice-readiness",
    "minecraft:readiness": "pnpm --filter @clankie/minecraft-mineflayer readiness",
    "minecraft:paper:bootstrap": "pnpm --filter @clankie/minecraft-mineflayer paper:bootstrap"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "tsx": "4.23.0",
    "turbo": "2.10.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
