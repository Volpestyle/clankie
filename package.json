{
  "name": "clankie",
  "version": "0.2.0",
  "private": true,
  "description": "Clankie: a persistent agent who codes, leads herdr fleets, plays games, and hangs out in Discord.",
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=@clankie/menu-bar --filter=@clankie/vox",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.config.ts && pnpm --filter @clankie/vox test && pnpm --filter @clankie/vox-client smoke debug",
    "lint": "oxlint --deny-warnings . && pnpm --filter @clankie/vox lint",
    "deadcode": "knip --include files,dependencies,unlisted,unresolved,exports,types,enumMembers,namespaceMembers",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check . && pnpm --filter @clankie/vox fmt:check",
    "docs:check": "node scripts/check-doc-links.mjs",
    "infra:check": "infra/aws/accounts/check.sh && infra/aws/public-gateway/check.sh",
    "testing:view": "node docs/testing/serve-archive.mjs",
    "check": "pnpm fmt:check && pnpm lint && pnpm deadcode && pnpm docs:check && pnpm infra:check && pnpm typecheck && pnpm test",
    "doctor": "node scripts/doctor.mjs",
    "cli:install": "node scripts/install-cli.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:smoke": "node scripts/smoke-release.mjs",
    "clean": "turbo run clean --filter=@clankie/menu-bar --filter=@clankie/vox && rm -rf .turbo .data",
    "play:live": "pnpm --filter @clankie/clankie free-play-live",
    "discord:readiness": "pnpm --filter @clankie/discord-bridge readiness",
    "discord:voice-readiness": "pnpm --filter @clankie/discord-bridge voice-readiness"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "knip": "6.32.2",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "turbo": "2.10.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0"
}
