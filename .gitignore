node_modules/
dist/
coverage/
.turbo/
*.tsbuildinfo
.data
# artifacts directories are generated; nested ones stay fully untracked.
**/artifacts/
/evals/holdout
# VUH-826 ruling: gate scorecards are committed under the root artifacts/evals/.
!/artifacts/
/artifacts/*
!/artifacts/evals/
# Redaction doctrine: transcript- and log-bearing eval evidence stays untracked.
/artifacts/evals/herdr-harness/
/artifacts/evals/real-workers/
/artifacts/evals/m1-exit-gate/
/artifacts/evals/self-build/*
# Bulk per-repetition evidence stays local; committed scorecards carry the gate.
/artifacts/evals/experiment/**/repetitions/
.env
.env.local
*.log
!docs/testing/**/evidence/*.log
.DS_Store
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
ios/Pods/
macos/Pods/
.pnpm-store/
/.local/
# Issue files are the owner's private notes (step 5); the folder ignores itself too.
/.clankie/work/
# Local proof scratch space and DynamoDB Local's working-directory metadata.
/.tmp/
/dynamodb-local-metadata.json
.codebase-index/
build/
.gradle/
.next/
.output/
DerivedData/
*.xcuserstate
.env.*

# eve framework generated runtime and discovery artifacts
**/.eve/
**/.workflow-data/
__pycache__/
*.pyc
# Raw evidence is uploaded to Clankie's evidence store and fetched into .local.
docs/testing/**/*.png
docs/testing/**/*.jpg
docs/testing/**/*.jpeg
docs/testing/**/*.gif
docs/testing/**/*.mp4
docs/testing/**/*.mov
docs/testing/**/*.webm

# Claude Code writes type scaffolding beside a loaded plugin's mods. It is never
# authored here, and in the pinned runtime it would read as local changes.
/integrations/claude-plugin/tsconfig.json
/integrations/claude-plugin/.claude-plugin/types/
/integrations/claude-plugin/worker/tsconfig.json
/integrations/claude-plugin/worker/.claude-plugin/types/
