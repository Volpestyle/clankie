+  it.each([1, 2])(
+    "executes fresh actions after rejoin at generation %i, but replays a lost response only once",
+    async (generation) => {
+      let current = observation({ frame: 10, x: 13 });
+      const receipts = new Map<string, ReturnType<typeof actRan>>();
+      let executions = 0;
+      let loseResponse = true;
+      const world = await fakeWorld(async (request) => {
+        switch (request.operation) {
+          case "world.join":
+            return joinResult();
+          case "play.observe":
+            return current;
+          case "play.act": {
+            const { idempotencyKey } = request.input as { idempotencyKey: string };
+            const previous = receipts.get(idempotencyKey);
+            if (previous !== undefined) return { ...previous, replayed: true };
+            executions += 1;
+            current = observation({
+              bodyGeneration: current.bodyGeneration,
+              frame: current.frame + 10,
+              x: 13 + executions,
+            });
+            const receipt = actRan(current);
+            receipts.set(idempotencyKey, receipt);
+            // The world applied the input, but the socket dies before its reply.
+            if (loseResponse) {
+              loseResponse = false;
+              throw new Error("response lost after execution");
+            }
+            return receipt;
+          }
+          case "play.frame":
+            return frame({
+              bodyGeneration: current.bodyGeneration,
+              frame: current.frame,
+              data: `screen-${String(executions)}`,
+            });
+          case "world.leave":
+            return { ok: true, sessionId: SESSION_ID, endedAt: NOW };
+          default:
+            throw new Error(`unexpected operation ${request.operation}`);
+        }
+      });
+      const env = await provisionedEnv(world.stateDir);
+      const first = await joinWorld({ environmentId: "pokemon-firered", env });
