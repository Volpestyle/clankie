+      const action = { kind: "button_press", button: "right", holdFrames: 4 } as const;
+      await expect(first.body.io.act(action)).resolves.toMatchObject({
+        status: "completed",
+        outcome: { replayed: true },
+      });
+      expect(executions).toBe(1);
+      await expect(first.body.io.act(action)).resolves.toMatchObject({
+        status: "completed",
+        outcome: { replayed: false },
+      });
+
+      // The host retains the session and deduplication receipts while the
+      // adapter is replaced, with or without a body-generation change.
+      current = observation({ bodyGeneration: generation, frame: 30, x: 15 });
+      const second = await joinWorld({ environmentId: "pokemon-firered", env });
+      if (second.outcome !== "joined") throw new Error("expected rejoin");
+      expect(second.body.sessionSnapshot()).toEqual(first.body.sessionSnapshot());
+      for (const x of [16, 17]) {
+        await expect(second.body.io.act(action)).resolves.toMatchObject({
+          status: "completed",
+          outcome: { replayed: false, bodyGeneration: generation },
+        });
+        expect(second.body.io.observe("overworld")).toMatchObject({ data: { position: { x } } });
+      }
+      expect(executions).toBe(4);
+      const keys = world.requests
+        .filter((request) => request.operation === "play.act")
+        .map((request) => (request.input as { idempotencyKey: string }).idempotencyKey);
+      expect(keys).toHaveLength(5);
+      expect(keys[0]).toBe(keys[1]);
+      expect(new Set(keys).size).toBe(4);
+      await first.body.close();
+      await second.body.close();
+    },
+  );
