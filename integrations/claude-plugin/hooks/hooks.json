{
  "description": "Clankie seat context, memory and settled transcript projection to the selected conversation.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["prompt", "--lane", "operator", "--sections", "persona,reach,fleet,address,model"],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["memory-card", "--lane", "operator"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 20
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
