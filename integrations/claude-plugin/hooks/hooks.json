{
  "description": "Clankie seat context, memory and settled transcript projection to the selected conversation.",
  "modules": ["../worker/mods/tool-catalog.mjs"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": [
              "prompt",
              "--lane",
              "operator",
              "--sections",
              "persona,reach,address,model,conversation",
              "--harness",
              "claude"
            ],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["memory-card", "--lane", "operator", "--hook"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["memory-card", "--lane", "operator", "--hook"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
