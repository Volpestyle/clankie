{
  "description": "Clankie seat context, memory and settled transcript projection to the selected conversation.",
  "modules": ["./mods/tool-catalog.mjs"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": [
              "prompt",
              "--lane",
              "operator",
              "--sections",
              "persona,reach,fleet,address,model,conversation",
              "--harness",
              "claude"
            ],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["memory-card", "--lane", "operator", "--hook"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/worker/bin/tracker-hook.mjs\" lead",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["memory-card", "--lane", "operator", "--hook"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*clankie *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/worker/bin/resource-hook.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*[Ll][Ii][Nn][Ee][Aa][Rr].*__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/worker/bin/tracker-hook.mjs\" lead",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
