{
  "description": "Clankie seat context, memory and settled transcript projection to the selected conversation.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["prompt", "--lane", "operator", "--sections", "persona,reach,fleet,address,model"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["memory-card", "--lane", "operator", "--hook"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["memory-card", "--lane", "operator", "--hook"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "clankie",
            "args": ["seat-sync"],
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
