{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$PLUGIN_ROOT/bin/seat-hook.mjs\" --codex", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$PLUGIN_ROOT/bin/seat-hook.mjs\" --codex", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/seat-hook.mjs\" --codex",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/bin/seat-hook.mjs\" --codex",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
