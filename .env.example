# Local control plane and runner
SAPLING_CONTROL_PLANE_URL=http://127.0.0.1:4310
SAPLING_RUNNER_URL=http://127.0.0.1:4311
SAPLING_RELAY_URL=ws://127.0.0.1:4320
SAPLING_RELAY_DEV_TOKEN=replace-with-at-least-16-random-characters
SAPLING_DATA_DIR=.data
SAPLING_LOG_LEVEL=debug
SAPLING_DOCTRINE=doctrine/profiles/self-build-lab.yaml

# Eve captain
CAPTAIN_MODEL=anthropic/claude-sonnet-5
AI_GATEWAY_API_KEY=

# Worker providers. Keep provider-native credentials on the runner host.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CODEX_HOME=
CLAUDE_CONFIG_DIR=

# Optional telemetry and crash reporting
OTEL_SERVICE_NAME=sapling-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SAPLING_ANALYTICS_ENABLED=false

# Official Discord bot credentials only. Never use a Discord user token.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
SAPLING_API_URL=http://127.0.0.1:4310
