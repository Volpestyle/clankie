{
  "name": "@clankie/discord-user-session",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "readiness": "tsx src/readiness-cli.ts",
    "live-proof": "tsx src/live-proof-cli.ts",
    "build": "tsc --noEmit -p tsconfig.json",
