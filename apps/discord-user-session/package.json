    "@clankie/interactive-environment": "workspace:*",
    "@clankie/protocol": "workspace:*",
    "@clankie/settings": "workspace:*",
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "discord-api-types": "0.38.49",
    "prism-media": "1.3.5",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/ws": "8.18.1",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
