{
  "name": "@sapling/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@sapling/api-client": "workspace:*",
    "@sapling/event-store": "workspace:*",
    "@sapling/observability": "workspace:*",
    "@sapling/protocol": "workspace:*",
    "@sapling/terminal-protocol": "workspace:*",
    "@sapling/worker-codex": "workspace:*",
    "@sapling/worker-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
